+@functools.cache
+def _compile_dense(
+    size_k: int,
+    size_n: int,
+    trellis_bits: int,
+    pair_kind: str | None,
+    rate_axis: str | None,
+    trellis_codebook: str,
+    m_tile_rows: int,
+    device_index: int,
+):
+    launch = _TrellisW4A8DenseLaunch(
+        size_k=size_k,
+        size_n=size_n,
+        trellis_bits=trellis_bits,
+        pair_kind=pair_kind,
+        rate_axis=rate_axis,
+        trellis_codebook=trellis_codebook,
+        m_tile_rows=m_tile_rows,
+    )
+    key = (
+        int(size_k),
+        int(size_n),
+        int(trellis_bits),
+        pair_kind,
+        rate_axis,
+        trellis_codebook,
+        int(m_tile_rows),
+        int(device_index),
+    )
