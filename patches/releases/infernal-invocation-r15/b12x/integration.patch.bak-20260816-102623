+    )
+    tier1_w13_stride = int(tiers[1].w13.numel()) // 6
+    tier1_w13 = tiers[1].w13.reshape(6, tier1_w13_stride)
+    runner_tiers = (
+        tiers[0],
+        replace(
+            tiers[1],
+            w13=torch.cat((tier1_w13[:2], tier1_w13[3:5])).contiguous(),
+        ),
+        tiers[2],
+    )
+    global_to_combined, descriptor = build_projection_tiered_maps(
