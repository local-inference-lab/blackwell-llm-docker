+            rotations,
+            launch,
+            buffers,
+            gate_experts=(3, 2, 1),
+            up_experts=(3, 2, 1),
+        )
+
+    eager = run().clone()
+    torch.cuda.synchronize(device)
+    relative = (eager - serial).norm() / serial.norm().clamp_min(1.0e-12)
+    assert float(relative) < 4.0e-3
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured = run()
+    graph.replay()
+    torch.cuda.synchronize(device)
+    assert torch.equal(captured, eager)
