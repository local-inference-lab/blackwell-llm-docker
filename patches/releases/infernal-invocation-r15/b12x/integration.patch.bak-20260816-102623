+            prepared,
+            output=actual_output,
+            gemm_output=actual_gemm,
+            rotated_f16=rotated_f16,
+            c_tmp=c_tmp,
+        )
+    actual_output.fill_(float("nan"))
+    graph.replay()
+    torch.cuda.synchronize(device)
+    assert torch.equal(captured, actual)
