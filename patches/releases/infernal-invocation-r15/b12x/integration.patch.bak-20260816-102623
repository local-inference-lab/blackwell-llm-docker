+def run_trellis256_uniform_dense_w4a8(
+    x: torch.Tensor,
+    prepared_dense,
+    **kwargs,
+) -> torch.Tensor:
+    """Execute a checkpoint-native uniform K3/K4 SQG tensor through W4A8.
