@@ -1,188 +0,0 @@
-"""Graph-safe BF16 to per-tensor E4M3 query quantization."""
-
-from __future__ import annotations
-
-from dataclasses import dataclass
-from threading import RLock
-
-import cuda.bindings.driver as cuda
-import cutlass
