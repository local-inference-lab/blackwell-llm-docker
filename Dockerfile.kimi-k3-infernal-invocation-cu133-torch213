ARG FLASHKDA_PATCH_FILE=releases/flashkda-sm120-tensormap-r1/flashkda/integration.patch
ARG FLASHKDA_PATCH_SHA256=2119fdd721decd873cdbbbe5263f624e21b8b2e83cede36d9f19e75377895951
