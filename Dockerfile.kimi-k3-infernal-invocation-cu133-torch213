FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG BASE_IMAGE_ID
ARG VLLM_REPO
ARG VLLM_REF
ARG VLLM_COMMIT
ARG VLLM_PATCH_FILE
ARG VLLM_PATCH_SHA256
ARG VLLM_INTEGRATION_TREE
ARG VLLM_INTEGRATION_LOCK_SHA256
ARG VLLM_PRS
ARG B12X_REPO
ARG B12X_REF
ARG B12X_COMMIT
