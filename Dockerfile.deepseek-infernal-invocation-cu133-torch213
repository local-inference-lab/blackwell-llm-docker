    CUDA_CACHE_PATH=/cache/jit/${CACHE_FINGERPRINT}/cuda \
    CUPY_CACHE_DIR=/cache/jit/${CACHE_FINGERPRINT}/cupy \
    HF_HOME=/root/.cache/huggingface

COPY patches /tmp/release-patches

# Every source directory is reconstructed from a release lock. The resulting
# Git tree is the runtime identity; a branch name alone is not sufficient.
RUN set -eux; \
    mkdir -p /opt/infernal-invocation; \
    verify_merge_stack() { \
      destination="$1"; tip="$2"; upstream_base="$3"; merge_heads="$4"; \
      test -n "${upstream_base}" || return 0; \
      if test -z "${merge_heads}"; then \
        test "${tip}" = "${upstream_base}"; \
        return 0; \
      fi; \
      IFS=',' read -r -a expected_heads <<< "${merge_heads}"; \
      current="${tip}"; \
      for ((index=${#expected_heads[@]} - 1; index >= 0; index--)); do \
        read -r -a commit_and_parents <<< \
          "$(git -C "${destination}" rev-list --parents -n 1 "${current}")"; \
        test "${#commit_and_parents[@]}" -eq 3; \
        test "${commit_and_parents[2]}" = "${expected_heads[index]}"; \
        current="${commit_and_parents[1]}"; \
      done; \
      test "${current}" = "${upstream_base}"; \
    }; \
    compose_source() { \
      component="$1"; destination="$2"; repository="$3"; reference="$4"; \
      commit="$5"; patch_file="$6"; patch_sha256="$7"; expected_tree="$8"; \
      upstream_base="${9:-}"; merge_heads="${10:-}"; \
      git clone --filter=blob:none --no-checkout "${repository}" "${destination}"; \
      git -C "${destination}" fetch --filter=blob:none origin "${reference}"; \
      git -C "${destination}" checkout --detach "${commit}"; \
      test "$(git -C "${destination}" rev-parse HEAD)" = "${commit}"; \
      verify_merge_stack "${destination}" "${commit}" \
        "${upstream_base}" "${merge_heads}"; \
      if test -n "${patch_file}"; then \
        patch_path="/tmp/release-patches/${patch_file}"; \
        echo "${patch_sha256}  ${patch_path}" | sha256sum -c -; \
        if test -s "${patch_path}"; then \
          git -C "${destination}" apply "${patch_path}"; \
        fi; \
      else \
        test -z "${patch_sha256}"; \
      fi; \
      git -C "${destination}" add -A; \
      actual_tree="$(git -C "${destination}" write-tree)"; \
      test "${actual_tree}" = "${expected_tree}" || { \
        echo "${component} tree ${actual_tree} does not match ${expected_tree}" >&2; exit 1; \
      }; \
    }; \
    compose_source vllm /opt/infernal-invocation/vllm \
      "${VLLM_REPO}" "${VLLM_REF}" "${VLLM_COMMIT}" \
      "${VLLM_PATCH_FILE}" "${VLLM_PATCH_SHA256}" "${VLLM_INTEGRATION_TREE}" \
      "${VLLM_UPSTREAM_BASE}" "${VLLM_MERGE_HEADS}"; \
    compose_source b12x /opt/infernal-invocation/b12x \
      "${B12X_REPO}" "${B12X_REF}" "${B12X_COMMIT}" \
      "${B12X_PATCH_FILE}" "${B12X_PATCH_SHA256}" "${B12X_INTEGRATION_TREE}" \
      "${B12X_UPSTREAM_BASE}" "${B12X_MERGE_HEADS}"; \
    compose_source lmcache /opt/infernal-invocation/lmcache \
      "${LMCACHE_REPO}" "${LMCACHE_REF}" "${LMCACHE_COMMIT}" \
      "${LMCACHE_PATCH_FILE}" "${LMCACHE_PATCH_SHA256}" "${LMCACHE_INTEGRATION_TREE}" \
      "${LMCACHE_UPSTREAM_BASE}" "${LMCACHE_MERGE_HEADS}"; \
    rm -rf /tmp/release-patches

# The virtual environment inherits CUDA, cuBLAS, cuDNN, NCCL, PyTorch,
# Torchvision, XGrammar, and Transformers from the NVIDIA-derived base.
RUN set -eux; \
    if [[ "${RUNTIME_FOUNDATION}" = 1 ]]; then \
      test -x /opt/venv/bin/python; \
      test "$(python -c 'import sys; print(sys.prefix)')" = /opt/venv; \
    else \
      python -m pip uninstall --yes grpcio-tools nvidia-resiliency-ext; \
      python -m venv --system-site-packages /opt/venv; \
      grep -v '^torch==' \
        /opt/infernal-invocation/vllm/requirements/build/cuda.txt \
        > /tmp/vllm-build-without-torch.txt; \
    fi

RUN --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    if [[ "${RUNTIME_FOUNDATION}" = 1 ]]; then \
      python -c 'import torch; assert torch.__version__.startswith("2.13.0")'; \
      CUTLASS_DSL_VERSION="${CUTLASS_DSL_VERSION}" python -c \
        'import importlib.metadata as m, os; assert m.version("nvidia-cutlass-dsl") == os.environ["CUTLASS_DSL_VERSION"]'; \
    else \
      python -m pip install --upgrade pip; \
      python -m pip install -r /tmp/vllm-build-without-torch.txt; \
      python -m pip install -r /opt/infernal-invocation/vllm/requirements/common.txt; \
      python -m pip install \
      'numba==0.65.0' \
      'fastsafetensors>=0.3.3' \
      'nvidia-cudnn-frontend>=1.19.1' \
      "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}" \
      'cupy-cuda13x==13.6.0' \
      'sortedcontainers==2.4.0' \
      'aiofile==3.11.1' \
      'aiofiles==25.1.0' \
      'redis==8.0.1' \
      'opentelemetry-exporter-prometheus==0.65b0' \
      'pytest==8.4.1' \
      'apache-tvm-ffi==0.1.11' \
      'torch-c-dlpack-ext==0.1.5' \
      'z3-solver==4.15.4.0' \
      'tokenspeed-triton==3.8.10.post20260721'; \
      python -m pip install --no-deps \
      'quack-kernels==0.6.4' \
      'humming-kernels[cu13]==0.1.12' \
      'tilelang==0.1.12' \
      'tokenspeed-mla==0.1.8'; \
      python -m pip install --force-reinstall --no-deps \
        "nvidia-cutlass-dsl-libs-cu13==${CUTLASS_DSL_VERSION}"; \
      python -m pip check; \
    fi

# FlashInfer provides sampling and the optional DeepSeek attention backend.
# Installing pinned wheels here leaves their expensive build stage independent
# from vLLM, B12X, and LMCache source revisions.
COPY --from=flashinfer-wheel-artifact /opt/flashinfer-wheels /tmp/flashinfer-wheels
RUN set -eux; \
    python -m pip uninstall --yes \
      flashinfer-python flashinfer-cubin flashinfer-jit-cache; \
    python -m pip install --no-deps --force-reinstall \
      /tmp/flashinfer-wheels/flashinfer_python-*.whl \
      /tmp/flashinfer-wheels/flashinfer_jit_cache-*.whl; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("flashinfer-python"))')" = \
      "${FLASHINFER_VERSION}"; \
    rm -rf /tmp/flashinfer-wheels

# DeepGEMM is the qualified dense linear backend for DeepSeek W4A8 serving.
RUN set -eux; \
    if [[ "${RUNTIME_FOUNDATION}" = 1 ]]; then \
      python -c 'import deep_gemm'; \
    else \
      git clone --filter=blob:none --no-checkout \
        "${DEEPGEMM_REPO}" /tmp/deepgemm-src; \
      git -C /tmp/deepgemm-src fetch --depth=1 origin "${DEEPGEMM_COMMIT}"; \
      git -C /tmp/deepgemm-src checkout --detach "${DEEPGEMM_COMMIT}"; \
      test "$(git -C /tmp/deepgemm-src rev-parse HEAD)" = "${DEEPGEMM_COMMIT}"; \
      git -C /tmp/deepgemm-src submodule update --init --recursive; \
      cd /tmp/deepgemm-src; \
      DG_FORCE_BUILD=1 DG_USE_LOCAL_VERSION=1 \
        python -m pip install --no-build-isolation --no-deps --force-reinstall .; \
      rm -rf /tmp/deepgemm-src; \
    fi

RUN python -m pip install --no-build-isolation --no-deps --force-reinstall \
      /opt/infernal-invocation/b12x

WORKDIR /opt/infernal-invocation/vllm

# vLLM native extensions are compiled against the packaged PyTorch 2.13 ABI.
RUN --mount=type=cache,id=deepseek-infernal-cu133-vllm-extensions,target=/tmp/vllm-extensions,sharing=locked \
    set -eux; \
    cmake -S . -B /tmp/vllm-extensions -G Ninja \
      -U MARLIN_GEN_SCRIPT_HASH_AND_ARCH \
      -U MOE_MARLIN_GEN_SCRIPT_HASH_AND_ARCH \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=75 \
      -DVLLM_TARGET_DEVICE=cuda \
      -DVLLM_PYTHON_EXECUTABLE=/opt/venv/bin/python \
      -DNVCC_THREADS=4; \
    cmake --build /tmp/vllm-extensions --parallel 48; \
    cmake --install /tmp/vllm-extensions \
      --prefix /tmp/vllm-flash-attn-python \
      --component _vllm_fa4_cutedsl_C; \
    test -f /tmp/vllm-flash-attn-python/vllm/vllm_flash_attn/cute/utils.py; \
    cp -a /tmp/vllm-flash-attn-python/vllm/vllm_flash_attn/cute \
      /opt/infernal-invocation/vllm/vllm/vllm_flash_attn/; \
    find /tmp/vllm-extensions -name '*.abi3.so' > /tmp/vllm-extension-list; \
    while IFS= read -r extension; do \
      case "${extension}" in \
        */vllm-flash-attn/*) destination=/opt/infernal-invocation/vllm/vllm/vllm_flash_attn ;; \
        */_deps/*) continue ;; \
        *) destination=/opt/infernal-invocation/vllm/vllm ;; \
      esac; \
      cp "${extension}" "${destination}/$(basename "${extension}")"; \
    done < /tmp/vllm-extension-list; \
    test -f /opt/infernal-invocation/vllm/vllm/_C_stable_libtorch.abi3.so; \
    test -f /opt/infernal-invocation/vllm/vllm/cumem_allocator.abi3.so; \
    test -f /opt/infernal-invocation/vllm/vllm/vllm_flash_attn/cute/utils.py

ARG TRITON_KERNELS_REPO=https://github.com/triton-lang/triton.git
ARG TRITON_KERNELS_COMMIT=0add68262ab0a2e33b84524346cb27cbb2787356

RUN git clone --filter=blob:none --no-checkout "${TRITON_KERNELS_REPO}" /tmp/triton-kernels-src \
 && git -C /tmp/triton-kernels-src fetch --depth=1 origin "${TRITON_KERNELS_COMMIT}" \
 && git -C /tmp/triton-kernels-src checkout --detach "${TRITON_KERNELS_COMMIT}" \
 && source_dir=/tmp/triton-kernels-src/python/triton_kernels/triton_kernels \
 && destination=/opt/infernal-invocation/vllm/vllm/third_party/triton_kernels \
 && test -f "${source_dir}/matmul_ogs.py" \
 && mkdir -p "${destination}" \
 && cp -a "${source_dir}/." "${destination}/" \
 && site_packages="$(python -c 'import site; print(site.getsitepackages()[0])')" \
 && if [[ -L "${site_packages}/triton_kernels" ]]; then \
      test "$(readlink "${site_packages}/triton_kernels")" = "${destination}"; \
    else \
      test ! -e "${site_packages}/triton_kernels"; \
      ln -s "${destination}" "${site_packages}/triton_kernels"; \
    fi \
 && rm -rf /tmp/triton-kernels-src

# The Python package install supplies metadata, CLI entry points, and Rust
# parsing binaries without replacing the native extension set above.
RUN set -eux; \
    if [[ "${RUNTIME_FOUNDATION}" != 1 ]]; then \
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain none --no-modify-path; \
    fi; \
    source /root/.cargo/env; \
    rust_toolchain="$(sed -n 's/^channel = "\([^"]*\)"/\1/p' rust-toolchain.toml)"; \
    if ! rustup toolchain list | grep -Fq "${rust_toolchain}"; then \
      rustup toolchain install "${rust_toolchain}"; \
    fi; \
    rustup default "${rust_toolchain}"; \
    python tools/build_rust.py --release; \
    VLLM_TARGET_DEVICE=empty VLLM_VERSION_OVERRIDE="${VLLM_PACKAGE_VERSION}" \
      VLLM_REQUIRE_RUST_FRONTEND=1 \
      python -m pip install --no-build-isolation --no-deps --force-reinstall .; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("vllm"))')" = \
      "${VLLM_PACKAGE_VERSION}"; \
    site_packages="$(python -c 'import site; print(site.getsitepackages()[0])')"; \
    installed_package="${site_packages}/vllm"; \
    test -d "${installed_package}"; \
    find /opt/infernal-invocation/vllm/vllm -maxdepth 1 -type f \
      -name '*.abi3.so' -exec cp -a -t "${installed_package}" {} +; \
    rm -rf "${installed_package}/vllm_flash_attn"; \
    cp -a /opt/infernal-invocation/vllm/vllm/vllm_flash_attn \
      "${installed_package}/vllm_flash_attn"; \
    test -f "${installed_package}/_C_stable_libtorch.abi3.so"; \
    test -f "${installed_package}/vllm_flash_attn/_vllm_fa2_C.abi3.so"; \
    (cd / && env -u PYTHONPATH python -c \
      'import pathlib, vllm; expected=pathlib.Path("/opt/venv/lib/python3.12/site-packages/vllm"); assert pathlib.Path(vllm.__file__).resolve().is_relative_to(expected)'); \
    rm -rf /root/.cargo /root/.rustup target rust/target

# LMCache is built against the same PyTorch ABI and includes only RAM and
# buffered filesystem dependencies in the serving runtime.
RUN rm -rf /tmp/lmcache-wheels \
 && mkdir -p /tmp/lmcache-wheels \
 && BUILD_WITH_CUDA=1 TORCH_CUDA_ARCH_LIST=12.0 MAX_JOBS=48 \
      SETUPTOOLS_SCM_PRETEND_VERSION_FOR_LMCACHE="${LMCACHE_BUILD_VERSION}" \
      python -m pip wheel --no-build-isolation --no-deps \
      -w /tmp/lmcache-wheels /opt/infernal-invocation/lmcache \
 && test "$(find /tmp/lmcache-wheels -maxdepth 1 -name 'lmcache-*.whl' | wc -l)" -eq 1 \
 && python -m pip install --no-deps --force-reinstall /tmp/lmcache-wheels/lmcache-*.whl \
 && test "$(python -c 'import importlib.metadata as m; print(m.version("lmcache"))')" = \
      "${LMCACHE_BUILD_VERSION}"

# The EXL3 checkpoint loader uses B12X kernels for rank-sliced inference. The
# pinned ExLlamaV3 source and extension provide generic checkpoint parity and
# the deterministic encoder used by the optional online K6 weight cache.
RUN set -eux; \
    if [[ "${RUNTIME_FOUNDATION}" = 1 ]]; then \
      VLLM_EXL3_EXT_PATH=/opt/exllamav3 python -c \
        'import importlib; assert hasattr(importlib.import_module("exllamav3_ext"), "exl3_gemm")'; \
      test -f /opt/exllamav3-python/exllamav3/modules/quant/exl3_lib/quantize.py; \
    else \
      git clone --filter=blob:none --no-checkout \
        "${EXLLAMAV3_REPO}" /tmp/exllamav3-src; \
      git -C /tmp/exllamav3-src fetch --depth=1 origin "${EXLLAMAV3_COMMIT}"; \
      git -C /tmp/exllamav3-src checkout --detach "${EXLLAMAV3_COMMIT}"; \
      test "$(git -C /tmp/exllamav3-src rev-parse HEAD)" = "${EXLLAMAV3_COMMIT}"; \
      cd /tmp/exllamav3-src; \
      TORCH_CUDA_ARCH_LIST=12.0a MAX_JOBS=48 python setup.py build_ext --inplace; \
      mapfile -t extensions < <(find . -maxdepth 1 -type f \
        -name 'exllamav3_ext*.so' -print); \
      test "${#extensions[@]}" -eq 1; \
      test -f exllamav3/modules/quant/exl3_lib/quantize.py; \
      install -d /opt/exllamav3 /opt/exllamav3-python; \
      install -m 0755 "${extensions[0]}" /opt/exllamav3/; \
      cp -a exllamav3 /opt/exllamav3-python/; \
      VLLM_EXL3_EXT_PATH=/opt/exllamav3 python -c \
        'import importlib; assert hasattr(importlib.import_module("exllamav3_ext"), "exl3_gemm")'; \
      rm -rf /tmp/exllamav3-src; \
    fi

ARG INSTANTTENSOR_VERSION=0.1.9
ARG INSTANTTENSOR_LIBAIO_REPO=https://github.com/sailfishos-mirror/libaio.git
ARG INSTANTTENSOR_LIBAIO_COMMIT=1b18bfafc6a2f7b9fa2c6be77a95afed8b7be448
ARG INSTANTTENSOR_LIBAIO_TREE=c9442e111b747e9329ea782c6edb9d13a827cc08
ARG NCCL4PY_VERSION=0.3.1

# InstantTensor supplies the distributed Safetensors loader required by the
# DeepSeek launchers. The canonical libaio repository is pinned to the
# submodule object and tree recorded by the InstantTensor source revision.
RUN set -eux; \
    if [[ "${RUNTIME_FOUNDATION}" = 1 ]]; then \
      test "$(python -c 'import importlib.metadata as m; print(m.version("instanttensor"))')" = \
        "${INSTANTTENSOR_VERSION}"; \
      test "$(python -c 'import importlib.metadata as m; print(m.version("nccl4py"))')" = \
        "${NCCL4PY_VERSION}"; \
    else \
      git clone --filter=blob:none --no-checkout \
        "${INSTANTTENSOR_REPO}" /tmp/instanttensor-src; \
      git -C /tmp/instanttensor-src fetch --depth=1 origin "${INSTANTTENSOR_COMMIT}"; \
      git -C /tmp/instanttensor-src checkout --detach "${INSTANTTENSOR_COMMIT}"; \
      test "$(git -C /tmp/instanttensor-src rev-parse HEAD)" = \
        "${INSTANTTENSOR_COMMIT}"; \
      test "$(git -C /tmp/instanttensor-src ls-tree HEAD \
        csrc/third_party/libaio | awk '{print $3}')" = \
        "${INSTANTTENSOR_LIBAIO_COMMIT}"; \
      git -C /tmp/instanttensor-src config \
        submodule.csrc/third_party/libaio.url "${INSTANTTENSOR_LIBAIO_REPO}"; \
      git -C /tmp/instanttensor-src submodule update --init --recursive; \
      test "$(git -C /tmp/instanttensor-src/csrc/third_party/libaio rev-parse HEAD)" = \
        "${INSTANTTENSOR_LIBAIO_COMMIT}"; \
      test "$(git -C /tmp/instanttensor-src/csrc/third_party/libaio \
        rev-parse 'HEAD^{tree}')" = "${INSTANTTENSOR_LIBAIO_TREE}"; \
      python -m pip install --no-build-isolation --no-deps \
        --force-reinstall /tmp/instanttensor-src; \
      test "$(python -c 'import importlib.metadata as m; print(m.version("instanttensor"))')" = \
        "${INSTANTTENSOR_VERSION}"; \
      rm -rf /tmp/instanttensor-src; \
      python -m pip install --no-deps "nccl4py==${NCCL4PY_VERSION}"; \
    fi

COPY launchers /tmp/runtime-launchers
RUN for script in /opt/infernal-invocation/vllm/serve-*.sh; do \
      if test -f "${script}"; then install -m 0755 "${script}" "/usr/local/bin/$(basename "${script}")"; fi; \
    done \
 && for script in /tmp/runtime-launchers/serve-*.sh \
      /tmp/runtime-launchers/glm52-*.sh \
      /tmp/runtime-launchers/lmcache-*.sh; do \
      install -m 0755 "${script}" "/usr/local/bin/$(basename "${script}")"; \
    done \
 && if test -f /tmp/runtime-launchers/glm52-pcie-calibration.py; then \
      install -m 0755 /tmp/runtime-launchers/glm52-pcie-calibration.py \
        /usr/local/bin/glm52-pcie-calibration.py; \
    fi \
 && test -x /usr/local/bin/serve-ds4-flash.sh \
 && test -x /usr/local/bin/serve-ds4-flash-spark.sh \
 && test -x /usr/local/bin/serve-infernal-invocation.sh \
 && test -x /usr/local/bin/serve-glm52-v19.sh \
