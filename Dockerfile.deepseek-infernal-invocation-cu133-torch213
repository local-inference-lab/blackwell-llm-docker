COPY tests/verify_deepseek_infernal_cu133_runtime.py /opt/local-inference/verify_deepseek_infernal_cu133_runtime.py
COPY tests/deepseek-infernal-cu133-pip-check.allowlist /opt/local-inference/deepseek-infernal-cu133-pip-check.allowlist

ARG XGRAMMAR_VERSION=0.2.5

# LMCache's package metadata includes cloud and GPUDirect Storage backends that
# are unsupported by this RAM and buffered-filesystem runtime. It also pins an
# older telemetry stack than vLLM. Match the complete known metadata delta so
# any additional missing or incompatible dependency still fails the build.
RUN set -e; \
    mkdir -p "/cache/jit/${CACHE_FINGERPRINT}"; \
    python /opt/local-inference/verify_deepseek_infernal_cu133_runtime.py \
      --vllm-version "${VLLM_PACKAGE_VERSION}" \
      --flashinfer-version "${FLASHINFER_VERSION}" \
      --lmcache-version "${LMCACHE_BUILD_VERSION}" \
      --instanttensor-version "${INSTANTTENSOR_VERSION}" \
      --cutlass-dsl-version "${CUTLASS_DSL_VERSION}" \
      --xgrammar-version "${XGRAMMAR_VERSION}"; \
    pip_status=0; \
    python -m pip check > /tmp/pip-check.actual 2>&1 || pip_status=$?; \
    test "${pip_status}" -eq 1; \
    sort -o /tmp/pip-check.actual /tmp/pip-check.actual; \
    sort /opt/local-inference/deepseek-infernal-cu133-pip-check.allowlist \
      > /tmp/pip-check.expected; \
    diff -u /tmp/pip-check.expected /tmp/pip-check.actual; \
    rm -f /tmp/pip-check.actual /tmp/pip-check.expected

