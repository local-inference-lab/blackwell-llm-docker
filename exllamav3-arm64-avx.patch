diff --git a/exllamav3/exllamav3_ext/parallel/all_reduce_cpu_arm64.cpp b/exllamav3/exllamav3_ext/parallel/all_reduce_cpu_arm64.cpp
new file mode 100644
index 0000000..253cfe1
--- /dev/null
+++ b/exllamav3/exllamav3_ext/parallel/all_reduce_cpu_arm64.cpp
@@ -0,0 +1,22 @@
+#include "all_reduce_cpu_avx2.h"
+#include "../util.h"
+
+// The upstream CPU process-group reducer uses x86 AVX2/AVX-512 intrinsics.
+// Keep the CUDA extension loadable on arm64 and reject this x86-only backend
+// explicitly if a multi-GPU caller selects it.
+void enable_fast_fp()
+{
+}
+
+void perform_cpu_reduce
+(
+    PGContext*,
+    size_t,
+    uint32_t,
+    uint8_t*,
+    size_t
+)
+{
+    TORCH_CHECK(false,
+        "ExLlamaV3 native CPU all-reduce requires x86 AVX2 and is unavailable on arm64");
+}
