#!/usr/bin/env bash
# Serve the official multimodal Kimi-K3 MXFP4 target with the Inferact DSpark
# draft. Native vLLM host KV offload is the default. LMCache and an uncached
# control remain explicit alternatives through HOST_KV_BACKEND.
set -euo pipefail

if [[ -n "${HOST_KV_BACKEND+x}" ]]; then
  host_kv_backend="${HOST_KV_BACKEND}"
elif [[ -z "${LMCACHE_MODE+x}" ]]; then
  host_kv_backend=native
elif [[ "${LMCACHE_MODE}" == off ]]; then
  # An explicit LMCACHE_MODE=off selects uncached execution.
  host_kv_backend=off
else
  # A configured LMCache mode selects the external cache backend.
  host_kv_backend=lmcache
fi

export HOST_KV_BACKEND="${host_kv_backend}"
export LMCACHE_L1_GB="${LMCACHE_L1_GB:-32}"
# The standalone cache server has no CUDA context. Existing vLLM workers own
# GPU gather/scatter operations and exchange bounded per-request CPU buffers
# with the server.
export LMCACHE_TRANSFER_MODE="${LMCACHE_TRANSFER_MODE:-engine_driven}"
export LMCACHE_EXPECTED_SOURCE_ROOT="${LMCACHE_EXPECTED_SOURCE_ROOT:-/opt/kimi-k3-qsrt/lmcache}"
export LMCACHE_SHM_NAME="${LMCACHE_SHM_NAME-}"
export LMCACHE_SEPARATE_OBJECT_GROUPS="${LMCACHE_SEPARATE_OBJECT_GROUPS:-1}"
export LMCACHE_SERVER_ENV="${LMCACHE_SERVER_ENV-CUDA_VISIBLE_DEVICES= CUDA_MODULE_LOADING=LAZY}"
# Pickle-mode restores share a Python/ZMQ control loop with heartbeat traffic.
# A large TP16 restore may occupy that loop for more than the generic 10-second
# interval even while the local cache server is healthy. The wrapper monitors
# the server process directly, while failed cache reads fall back to model
# recomputation, so a 30-second heartbeat preserves liveness without turning
# a transient control-plane delay into an empty API response.
export LMCACHE_HEARTBEAT_INTERVAL="${LMCACHE_HEARTBEAT_INTERVAL:-30}"
export LMCACHE_WORKER_REAP_TIMEOUT="${LMCACHE_WORKER_REAP_TIMEOUT:-120}"
export LMCACHE_KV_LOAD_FAILURE_POLICY="${LMCACHE_KV_LOAD_FAILURE_POLICY:-recompute}"
# Kimi-K3 DCP16 exposes 768-token scheduler blocks and 12,288-token MLA
# transfer groups. LMCache chunks must preserve both granularities.
export LMCACHE_CHUNK_SIZE="${LMCACHE_CHUNK_SIZE:-12288}"
export ENABLE_PREFIX_CACHING="${ENABLE_PREFIX_CACHING:-1}"
export ENABLE_VISION="${ENABLE_VISION:-1}"
# Kimi-K3 vision attention heads are not divisible by TP16, so vLLM executes
# the encoder data-parallel even when weight parallelism is requested. The
# processor-wide patch limits below bound each encoded image independently of
# the number of images in a request.
export MM_ENCODER_TP_MODE="${MM_ENCODER_TP_MODE:-weights}"
# Kimi-K3 resizes every image before encoder execution. The deployment-wide
# patch cap bounds startup profiling and request-time vision activations while
# retaining the checkpoint's maximum single-side resolution for panoramas.
export VISION_IN_PATCH_LIMIT="${VISION_IN_PATCH_LIMIT:-40960}"
export VISION_PATCH_LIMIT_ON_ONE_SIDE="${VISION_PATCH_LIMIT_ON_ONE_SIDE:-512}"
export TP_SIZE="${TP_SIZE:-16}"
export DCP_SIZE="${DCP_SIZE:-16}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-1000000}"
export MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-4102}"
export KV_CACHE_MEMORY_BYTES="${KV_CACHE_MEMORY_BYTES:-1325000000}"
export B12X_MOE_WORKSPACE_TOKEN_LIMIT="${B12X_MOE_WORKSPACE_TOKEN_LIMIT:-4096}"
export B12X_W4A16_PREFILL_FUSED_SUM="${B12X_W4A16_PREFILL_FUSED_SUM:-1}"
export B12X_W4A16_STABLE_ROUTE_PACK="${B12X_W4A16_STABLE_ROUTE_PACK:-1}"

lmcache_wrapper="${LMCACHE_WRAPPER:-/usr/local/bin/lmcache-mp-wrapper.sh}"
dspark_launcher="${KIMI_DSPARK_LAUNCHER:-/usr/local/bin/serve-kimi-k3-full-mxfp4-dspark-ii}"
host_kv_args=()

case "${host_kv_backend}" in
  native)
    export LMCACHE_MODE=off
    # CPUOffloadingSpec performs bounded local DMA copies and does not retain
    # raw CUDA allocation addresses across allocator remaps. Preserve an
    # operator override while enabling VMM-backed expandable segments by
    # default to avoid fragmentation near the configured KV-cache limit.
    export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
    host_kv_args=(
      --kv-offloading-size "${KV_OFFLOADING_SIZE:-32}"
      --kv-offloading-backend native
    )
    ;;
  lmcache)
    export LMCACHE_MODE="${LMCACHE_MODE:-ram}"
    case "${LMCACHE_MODE}" in
      ram|disk) ;;
      *)
        echo "HOST_KV_BACKEND=lmcache requires LMCACHE_MODE=ram or disk" >&2
        exit 2
        ;;
    esac
    ;;
  off)
    export LMCACHE_MODE=off
    ;;
  *)
    echo "HOST_KV_BACKEND must be native, lmcache, or off; got ${host_kv_backend}" >&2
    exit 2
    ;;
esac

exec "${lmcache_wrapper}" \
  "${dspark_launcher}" \
  "${host_kv_args[@]}" \
  "$@"
